{
  "name": "axii-benchmark",
  "version": "1.0.0",
  "description": "Performance benchmark comparing Axii with mainstream frontend frameworks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "benchmark": "node scripts/run-benchmarks.js",
    "benchmark:real": "npm run build && node scripts/run-real-browser-benchmark.js",
    "benchmark:memory": "npm run build && node scripts/run-memory-benchmark.js",
    "heap:snapshot": "node scripts/run-axii-heap-snapshots.js",
    "benchmark:dev": "node scripts/run-benchmarks.js --dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axii": "^4.4.1",
    "data0": "^2.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "solid-js": "^1.9.14",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "playwright": "^1.49.1",
    "typescript": "^5.6.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axiijs/axii-benchmark.git"
  },
  "keywords": [
    "axii",
    "benchmark",
    "performance",
    "frontend",
    "framework",
    "comparison"
  ],
  "author": "Axii Team",
  "license": "MIT"
}
