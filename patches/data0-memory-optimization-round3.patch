                 if (dep.delete(this)) trackRetainedDepEffectRemoved(dep)
                 dep.add(target)
                 trackRetainedDepEffectAdded(dep)
-                target.deps.push(dep)
+                target.addDep(dep)
             }
             deps.length = 0
         }
